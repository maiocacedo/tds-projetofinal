# Copie este arquivo para .env (que é ignorado pelo Git) e preencha os valores.
# A API importa o .env da pasta de onde é executada (raiz do projeto) via spring.config.import.
# Variáveis de ambiente reais do sistema têm prioridade sobre o .env.

# Obrigatória. Segredo HMAC do JWT, 32 bytes ou mais. Pode ser trocado: só invalida os tokens já emitidos.
# Gerar (PowerShell): $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Obrigatória. Chave AES-256 em base64 (exatamente 32 bytes). NUNCA troque depois do primeiro uso:
# allergies e bio já gravadas ficam ilegíveis com outra chave.
# Gerar (PowerShell): $k = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($k); [Convert]::ToBase64String($k)
APP_CRYPTO_KEY=

# Opcional. Sem ela não existe admin da plataforma. Use a mesma senha na variável adminPassword do Postman.
ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@nossoteto.local

# Opcionais (valores padrão mostrados)
# JWT_ACCESS_TTL=PT15M
# JWT_REFRESH_TTL=P7D
# COOKIE_SECURE=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# WEB_CLIENT_SECRET=web-dev-secret
# MOBILE_CLIENT_SECRET=mobile-dev-secret
